{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed",
          "on_shelf"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "propwash:item/remote"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:composite",
      "models": [
        {
          "type": "minecraft:model",
          "model": "propwash:item/remote_body"
        },
        {
          "type": "minecraft:special",
          "base": "propwash:item/remote_body",
          "model": {
            "type": "propwash:remote_gimbals"
          }
        }
      ]
    }
  }
}
